import random
from datetime import datetime, timedelta, timezone

from fastapi import APIRouter, Depends, HTTPException
from sqlmodel import select
from sqlmodel.ext.asyncio.session import AsyncSession

from app.core.security import create_access_token, hash_value, verify_value
from app.db.session import get_session
from app.models import OTPVerification, User
from app.schemas import (
    LoginRequest,
    OTPRequest,
    OTPVerifyRequest,
    SignupRequest,
    TokenResponse,
)

router = APIRouter(prefix="/auth", tags=["auth"])

OTP_EXPIRE_MINUTES = 5
MAX_OTP_ATTEMPTS = 5


@router.post("/signup", response_model=TokenResponse)
async def signup(payload: SignupRequest, session: AsyncSession = Depends(get_session)):
    if not payload.consent_given:
        raise HTTPException(400, "Consent is required to create an account")

    result = await session.exec(select(User).where(User.email == payload.email))
    if result.first():
        raise HTTPException(400, "Email already registered")

    user = User(
        name=payload.name,
        email=payload.email,
        password_hash=hash_value(payload.password),
        auth_provider="email",
        preferred_language=payload.preferred_language,
        consent_given_at=datetime.now(timezone.utc),
    )
    session.add(user)
    await session.commit()
    await session.refresh(user)

    token = create_access_token(user.id, user.role)
    return TokenResponse(access_token=token, user_id=user.id, role=user.role)


@router.post("/login", response_model=TokenResponse)
async def login(payload: LoginRequest, session: AsyncSession = Depends(get_session)):
    result = await session.exec(select(User).where(User.email == payload.email))
    user = result.first()
    if not user or not user.password_hash or not verify_value(payload.password, user.password_hash):
        raise HTTPException(401, "Incorrect email or password")

    user.last_login_at = datetime.now(timezone.utc)
    session.add(user)
    await session.commit()

    token = create_access_token(user.id, user.role)
    return TokenResponse(access_token=token, user_id=user.id, role=user.role)


@router.post("/otp/request")
async def request_otp(payload: OTPRequest, session: AsyncSession = Depends(get_session)):
    code = f"{random.randint(0, 999999):06d}"
    otp = OTPVerification(
        identifier=payload.phone,
        code_hash=hash_value(code),
        purpose=payload.purpose,
        expires_at=datetime.now(timezone.utc) + timedelta(minutes=OTP_EXPIRE_MINUTES),
    )
    session.add(otp)
    await session.commit()

    # TODO Phase 1: send via SMS gateway (Twilio / MSG91) instead of returning it.
    # Returned directly here so you can test the flow locally without a gateway account.
    return {"message": "OTP sent", "dev_only_code": code}


@router.post("/otp/verify", response_model=TokenResponse)
async def verify_otp(payload: OTPVerifyRequest, session: AsyncSession = Depends(get_session)):
    result = await session.exec(
        select(OTPVerification)
        .where(OTPVerification.identifier == payload.phone, OTPVerification.verified == False)  # noqa: E712
        .order_by(OTPVerification.created_at.desc())
    )
    otp = result.first()

    if not otp or otp.expires_at < datetime.now(timezone.utc):
        raise HTTPException(400, "OTP expired or not found")
    if otp.attempts >= MAX_OTP_ATTEMPTS:
        raise HTTPException(429, "Too many attempts, request a new OTP")
    if not verify_value(payload.code, otp.code_hash):
        otp.attempts += 1
        session.add(otp)
        await session.commit()
        raise HTTPException(400, "Incorrect OTP")

    otp.verified = True
    session.add(otp)

    result = await session.exec(select(User).where(User.phone == payload.phone))
    user = result.first()
    if not user:
        if not payload.consent_given:
            raise HTTPException(400, "Consent is required to create an account")
        user = User(
            phone=payload.phone,
            phone_verified=True,
            auth_provider="phone",
            consent_given_at=datetime.now(timezone.utc),
        )
    else:
        user.phone_verified = True
        user.last_login_at = datetime.now(timezone.utc)

    session.add(user)
    await session.commit()
    await session.refresh(user)

    token = create_access_token(user.id, user.role)
    return TokenResponse(access_token=token, user_id=user.id, role=user.role)
